generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  emailVerified Boolean        @default(false)
  googleId      String?        @unique
  passwordHash  String?
  firstName     String
  lastName      String
  phone         String?        @unique
  avatarUrl     String?
  role          Role           @default(CLIENT)
  kycStatus     KycStatus      @default(PENDING)
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  activityLogs  ActivityLog[]
  devices       Device[]
  loans         Loan[]
  notifications Notification[]
  payments      Payment[]

  verificationTokens VerificationToken[]
  sellInstructions   SellInstruction[]

  @@index([email])
  @@map("users")
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("verification_tokens")
}


model Device {
  id         String   @id @default(uuid())
  userId     String
  pushToken  String?
  platform   String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model Account {
  id            String        @id @default(uuid())
  userId        String
  accountNumber String        @unique
  type          AccountType
  status        AccountStatus @default(ACTIVE)
  currency      String        @default("NGN")
  balance       Decimal       @default(0) @db.Decimal(18, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan          Loan?
  portfolio     Portfolio?
  transactions  Transaction[]

  @@index([userId])
  @@map("accounts")
}

model Portfolio {
  id         String    @id @default(uuid())
  accountId  String    @unique
  name       String    @default("Primary Portfolio")
  totalValue Decimal   @default(0) @db.Decimal(18, 2)
  currency   String    @default("NGN")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  holdings   Holding[]
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("portfolios")
}

model Asset {
  id           String    @id @default(uuid())
  symbol       String    @unique
  name         String
  type         AssetType
  currency     String    @default("NGN")
  currentPrice Decimal   @default(0) @db.Decimal(18, 4)
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())
  holdings     Holding[]

  @@map("assets")
}

model Holding {
  id          String    @id @default(uuid())
  portfolioId String
  assetId     String
  quantity    Decimal   @default(0) @db.Decimal(18, 6)
  averageCost Decimal   @default(0) @db.Decimal(18, 4)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  asset       Asset     @relation(fields: [assetId], references: [id])
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, assetId])
  @@index([portfolioId])
  @@map("holdings")
}

model Transaction {
  id          String            @id @default(uuid())
  accountId   String
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  amount      Decimal           @db.Decimal(18, 2)
  currency    String            @default("NGN")
  reference   String            @unique
  description String?
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  payment     Payment?
  account     Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([reference])
  @@map("transactions")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model Payment {
  id               String          @id @default(uuid())
  userId           String
  transactionId    String?         @unique
  provider         PaymentProvider @default(PAYSTACK)
  reference        String          @unique
  authorizationUrl String?
  channel          String?
  amount           Decimal         @db.Decimal(18, 2)
  currency         String          @default("NGN")
  status           PaymentStatus   @default(INITIATED)
  paidAt           DateTime?
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  transaction      Transaction?    @relation(fields: [transactionId], references: [id])
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reference])
  @@map("payments")
}

model Loan {
  id                 String     @id @default(uuid())
  userId             String
  accountId          String     @unique
  principal          Decimal    @db.Decimal(18, 2)
  interestRate       Decimal    @db.Decimal(5, 2)
  tenureMonths       Int
  outstandingBalance Decimal    @db.Decimal(18, 2)
  status             LoanStatus @default(APPLIED)
  purpose            String?
  approvedAt         DateTime?
  disbursedAt        DateTime?
  closedAt           DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  account            Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("loans")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

enum Role {
  CLIENT
  ADVISOR
  ADMIN
}

enum KycStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum AccountType {
  SAVINGS
  INVESTMENT
  LOAN
  FIXED_DEPOSIT
}

enum AccountStatus {
  ACTIVE
  DORMANT
  FROZEN
  CLOSED
}

enum AssetType {
  STOCK
  BOND
  MUTUAL_FUND
  ETF
  FIXED_DEPOSIT
  REAL_ESTATE
  CASH
  OTHER
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BUY
  SELL
  INTEREST
  FEE
  DIVIDEND
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum PaymentProvider {
  PAYSTACK
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REFUNDED
}

enum LoanStatus {
  APPLIED
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISBURSED
  REPAYING
  CLOSED
  DEFAULTED
}

enum NotificationType {
  TRANSACTION
  PORTFOLIO_UPDATE
  LOAN_UPDATE
  SECURITY
  SYSTEM
  MARKETING
}

model SellInstruction {
  id          String                @id @default(uuid())
  userId      String
  assetSymbol String
  assetName   String
  quantity    Decimal               @db.Decimal(18, 6)
  targetPrice Decimal?              @db.Decimal(18, 4)
  notes       String?
  status      SellInstructionStatus @default(PENDING)
  adminNotes  String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("sell_instructions")
}

enum SellInstructionStatus {
  PENDING
  IN_REVIEW
  EXECUTED
  REJECTED
  CANCELLED
}

